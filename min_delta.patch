 from lightning.pytorch.callbacks import EarlyStopping
+
+# Seuil de significativité pour l'early stopping [ADR-003 §6].
+# Lightning met min_delta=0.0 par défaut : la patience se réarme sur un gain
+# de 0.0005, donc sur du bruit. Constaté au batch 1 : SigLIP2 a enchaîné 6
+# "améliorations" de 0.001 (0.768 → 0.771) sans progrès réel, épuisant son
+# plafond d'époques pour rien.
+# 0.002 = moitié de l'écart-type d'échantillonnage du F1 pondéré sur une
+# validation de 3k-10k samples (σ ≈ 0.004-0.005). En-dessous, une
+# "amélioration" n'est pas distinguable du bruit de tirage.
+# Constante et non paramètre YAML : c'est un seuil de significativité
+# statistique, pas un hyperparamètre à explorer.
+EARLY_STOP_MIN_DELTA = 0.002
+
